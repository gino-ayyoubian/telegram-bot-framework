{
  "name": "telegram-bot-framework",
  "version": "1.0.0",
  "description": "Complete Telegram bot with workflow engine, session management, PostgreSQL, and REST API",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
